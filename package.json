{
  "name": "ocelot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:worker": "wrangler dev --local --config wrangler.local.jsonc --ip 127.0.0.1 --port 8787",
    "dev:web": "vite --host 127.0.0.1",
    "db:migrate": "wrangler d1 migrations apply ocelot-local --local --config wrangler.local.jsonc",
    "db:seed": "wrangler d1 execute ocelot-local --local --config wrangler.local.jsonc --file fixtures/seed.sql",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types worker/worker-configuration.d.ts --env-interface WorkerBindings --include-runtime false --strict-vars false",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "bun run typecheck && bun run lint && bun run test:coverage && bun run build",
    "worker:check": "wrangler deploy --dry-run --outdir output/worker",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@nocoo/basalt": "2.1.7",
    "@pierre/trees": "1.0.0-beta.6",
    "jose": "6.2.12",
    "katex": "0.16.47",
    "lucide-react": "1.44.0",
    "mdast-util-to-string": "4.0.0",
    "mermaid": "12.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.13",
    "@cloudflare/vitest-plugin": "1.1.7",
    "@cloudflare/workers-types": "5.20260911.1",
    "@playwright/test": "1.63.0",
    "@types/hast": "3.0.4",
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-istanbul": "4.1.11",
    "husky": "9.1.7",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.131.0"
  }
}
